@@ -0,0 +1,65 @@
+package com.ojj.sujuro.schedule;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.ojj.sujuro.user.CodeOption;
+
+/** 일정 화면에 필요한 값 (월 캘린더) */
+public class ScheduleView {
+
+    /** 캘린더 칸 하나. day 가 0 이면 앞쪽 빈 칸 */
+    public static class Cell {
+        private final int day;
+        private final boolean today;
+        private final List<ScheduleEvent> events;
+
+        public Cell(int day, boolean today, List<ScheduleEvent> events) {
+            this.day = day;
+            this.today = today;
+            this.events = events;
+        }
+
+        public int getDay() { return day; }
+        public boolean isToday() { return today; }
+        public List<ScheduleEvent> getEvents() { return events; }
+        public boolean isBlank() { return day == 0; }
+    }
+
+    private String ym;          // 2026-10
+    private String label;       // 2026년 10월
+    private String prevYm;
+    private String nextYm;
+    private String scopeText;   // 지금 보는 범위 설명
+    private final List<Cell> cells = new ArrayList<>();
+    private List<CodeOption> kinds = new ArrayList<>();         // 범례
+    private List<CodeOption> teams = new ArrayList<>();         // 팀 탭 (영업부·경영지원실만)
+    private Long selectedTeamSn;                                // null 이면 전체
+    private boolean canEdit;                                    // 팀장만 내부 일정을 만든다 (FR-093)
+    private List<CodeOption> editableKinds = new ArrayList<>(); // 내부 일정으로 만들 수 있는 구분
+    private ScheduleEvent editing;                              // 수정 중인 내부 일정
+
+    public String getYm() { return ym; }
+    public void setYm(String v) { this.ym = v; }
+    public String getLabel() { return label; }
+    public void setLabel(String v) { this.label = v; }
+    public String getPrevYm() { return prevYm; }
+    public void setPrevYm(String v) { this.prevYm = v; }
+    public String getNextYm() { return nextYm; }
+    public void setNextYm(String v) { this.nextYm = v; }
+    public String getScopeText() { return scopeText; }
+    public void setScopeText(String v) { this.scopeText = v; }
+    public List<Cell> getCells() { return cells; }
+    public List<CodeOption> getKinds() { return kinds; }
+    public void setKinds(List<CodeOption> v) { this.kinds = v; }
+    public List<CodeOption> getTeams() { return teams; }
+    public void setTeams(List<CodeOption> v) { this.teams = v; }
+    public Long getSelectedTeamSn() { return selectedTeamSn; }
+    public void setSelectedTeamSn(Long v) { this.selectedTeamSn = v; }
+    public boolean isCanEdit() { return canEdit; }
+    public void setCanEdit(boolean v) { this.canEdit = v; }
+    public List<CodeOption> getEditableKinds() { return editableKinds; }
+    public void setEditableKinds(List<CodeOption> v) { this.editableKinds = v; }
+    public ScheduleEvent getEditing() { return editing; }
+    public void setEditing(ScheduleEvent v) { this.editing = v; }
+}
diff --git a/src/main/resources/mapper/schedule/ScheduleMapper.xml b/src/main/resources/mapper/schedule/ScheduleMapper.xml
new file mode 100644
index 0000000..31a4fc9
--- /dev/null
+++ b/src/main/resources/mapper/schedule/ScheduleMapper.xml
@@ -0,0 +1,119 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
+<!--
+  일정 SQL (FR-091 ~ FR-094). 테이블: TB_SCHDL, TB_BID_PBANC, TB_SBMSN_DCMNT, TB_TEAM, TB_COM_CD (db/01_schema.sql)
+  공고의 제출 마감·발표일·서류 마감은 TB_SCHDL 에 따로 복사하지 않고 조회할 때 공고에서 바로 가져온다.
+  그래서 마감일이 바뀌거나 재공고로 새 사업건이 들어와도 항상 최신 날짜로 보인다. (FR-092)
+  PS010 신규(아직 팀에 배정 전)와 PS090 불참은 일정에 넣지 않는다.
+-->
+<mapper namespace="com.ojj.sujuro.schedule.ScheduleMapper">
+
+  <select id="findMyTeamSn" resultType="long">
+    SELECT TEAM_SN FROM TB_USER WHERE USER_ID = #{userId}
+  </select>
+
+  <select id="findDevTeams" resultType="com.ojj.sujuro.user.CodeOption">
+    SELECT TO_CHAR(TEAM_SN) AS code, TEAM_NM AS name
+      FROM TB_TEAM
+     WHERE USE_YN = 'Y' AND DEPT_CD = 'DP030'
+     ORDER BY TEAM_SN
+  </select>
+
+  <select id="findKinds" resultType="com.ojj.sujuro.user.CodeOption">
+    SELECT CD AS code, CD_NM AS name
+      FROM TB_COM_CD
+     WHERE GROUP_CD = 'SCHSE' AND USE_YN = 'Y'
+     ORDER BY SORT_SEQ
+  </select>
+
+  <select id="findAutoEvents" resultType="com.ojj.sujuro.schedule.ScheduleEvent">
+    SELECT CAST(NULL AS NUMBER) AS id,
+           TO_CHAR(P.BID_DDLN_DT, 'YYYY-MM-DD') AS eventDate,
+           TO_CHAR(P.BID_DDLN_DT, 'HH24:MI') AS timeText,
+           '제출 마감 · ' || P.PBANC_NM AS title,
+           'SC010' AS kindCd, TM.TEAM_NM AS teamNm, P.PBANC_SN AS pbancSn
+      FROM TB_BID_PBANC P
+      JOIN TB_TEAM TM ON TM.TEAM_SN = P.SPRVSN_TEAM_SN
+     WHERE P.PBANC_STTS_CD NOT IN ('PS010', 'PS090')
+       AND P.BID_DDLN_DT &gt;= TO_DATE(#{from}, 'YYYY-MM-DD')
+       AND P.BID_DDLN_DT &lt; TO_DATE(#{to}, 'YYYY-MM-DD') + 1
+    <if test="teamSn != null">
+       AND P.SPRVSN_TEAM_SN = #{teamSn}
+    </if>
+    UNION ALL
+    SELECT CAST(NULL AS NUMBER),
+           TO_CHAR(P.PRSNTN_DT, 'YYYY-MM-DD'),
+           TO_CHAR(P.PRSNTN_DT, 'HH24:MI'),
+           '발표 · ' || P.PBANC_NM,
+           'SC040', TM.TEAM_NM, P.PBANC_SN
+      FROM TB_BID_PBANC P
+      JOIN TB_TEAM TM ON TM.TEAM_SN = P.SPRVSN_TEAM_SN
+     WHERE P.PBANC_STTS_CD NOT IN ('PS010', 'PS090')
+       AND P.PRSNTN_DT &gt;= TO_DATE(#{from}, 'YYYY-MM-DD')
+       AND P.PRSNTN_DT &lt; TO_DATE(#{to}, 'YYYY-MM-DD') + 1
+    <if test="teamSn != null">
+       AND P.SPRVSN_TEAM_SN = #{teamSn}
+    </if>
+    UNION ALL
+    SELECT CAST(NULL AS NUMBER),
+           TO_CHAR(D.SBMSN_DDLN_DT, 'YYYY-MM-DD'),
+           TO_CHAR(D.SBMSN_DDLN_DT, 'HH24:MI'),
+           '서류 마감 · ' || D.DCMNT_NM,
+           'SC050', TM.TEAM_NM, P.PBANC_SN
+      FROM TB_SBMSN_DCMNT D
+      JOIN TB_BID_PBANC P ON P.PBANC_SN = D.PBANC_SN
+      JOIN TB_TEAM TM ON TM.TEAM_SN = P.SPRVSN_TEAM_SN
+     WHERE P.PBANC_STTS_CD NOT IN ('PS010', 'PS060', 'PS090')
+       AND D.SBMSN_DDLN_DT IS NOT NULL
+       AND (P.BID_DDLN_DT IS NULL OR TRUNC(D.SBMSN_DDLN_DT) &lt;&gt; TRUNC(P.BID_DDLN_DT))
+       AND D.SBMSN_DDLN_DT &gt;= TO_DATE(#{from}, 'YYYY-MM-DD')
+       AND D.SBMSN_DDLN_DT &lt; TO_DATE(#{to}, 'YYYY-MM-DD') + 1
+    <if test="teamSn != null">
+       AND P.SPRVSN_TEAM_SN = #{teamSn}
+    </if>
+  </select>
+
+  <sql id="internalCols">
+    S.SCHDL_SN AS id,
+    TO_CHAR(S.SCHDL_BGNG_DT, 'YYYY-MM-DD') AS eventDate,
+    CASE WHEN TO_CHAR(S.SCHDL_BGNG_DT, 'HH24:MI') = '00:00' THEN NULL ELSE TO_CHAR(S.SCHDL_BGNG_DT, 'HH24:MI') END AS timeText,
+    S.SCHDL_TTL AS title, S.SCHDL_SE_CD AS kindCd, TM.TEAM_NM AS teamNm, S.PBANC_SN AS pbancSn
+  </sql>
+
+  <select id="findInternalEvents" resultType="com.ojj.sujuro.schedule.ScheduleEvent">
+    SELECT <include refid="internalCols"/>
+      FROM TB_SCHDL S
+      JOIN TB_TEAM TM ON TM.TEAM_SN = S.TEAM_SN
+     WHERE S.AUTO_REG_YN = 'N'
+       AND S.SCHDL_BGNG_DT &gt;= TO_DATE(#{from}, 'YYYY-MM-DD')
+       AND S.SCHDL_BGNG_DT &lt; TO_DATE(#{to}, 'YYYY-MM-DD') + 1
+    <if test="teamSn != null">
+       AND S.TEAM_SN = #{teamSn}
+    </if>
+     ORDER BY S.SCHDL_BGNG_DT, S.SCHDL_SN
+  </select>
+
+  <select id="findInternalOne" resultType="com.ojj.sujuro.schedule.ScheduleEvent">
+    SELECT <include refid="internalCols"/>
+      FROM TB_SCHDL S
+      JOIN TB_TEAM TM ON TM.TEAM_SN = S.TEAM_SN
+     WHERE S.SCHDL_SN = #{schdlSn} AND S.TEAM_SN = #{teamSn} AND S.AUTO_REG_YN = 'N'
+  </select>
+
+  <insert id="insert">
+    INSERT INTO TB_SCHDL (TEAM_SN, SCHDL_SE_CD, SCHDL_TTL, SCHDL_BGNG_DT, AUTO_REG_YN, RGTR_ID)
+    VALUES (#{teamSn}, #{kindCd}, #{title}, TO_DATE(#{date}, 'YYYY-MM-DD'), 'N', #{userId})
+  </insert>
+
+  <!-- 자기 팀의 내부 일정만 바뀐다. 공고에서 자동으로 들어온 일정(AUTO_REG_YN=Y)은 바꾸지 못한다. -->
+  <update id="update">
+    UPDATE TB_SCHDL
+       SET SCHDL_SE_CD = #{kindCd}, SCHDL_TTL = #{title}, SCHDL_BGNG_DT = TO_DATE(#{date}, 'YYYY-MM-DD')
+     WHERE SCHDL_SN = #{schdlSn} AND TEAM_SN = #{teamSn} AND AUTO_REG_YN = 'N'
+  </update>
+
+  <delete id="delete">
+    DELETE FROM TB_SCHDL WHERE SCHDL_SN = #{schdlSn} AND TEAM_SN = #{teamSn} AND AUTO_REG_YN = 'N'
+  </delete>
+
+</mapper>
diff --git a/src/main/resources/templates/schedule/index.html b/src/main/resources/templates/schedule/index.html
new file mode 100644
index 0000000..0879cf8
--- /dev/null
+++ b/src/main/resources/templates/schedule/index.html
@@ -0,0 +1,89 @@
+<!DOCTYPE html>
+<html lang="ko"
+      xmlns:th="http://www.thymeleaf.org"
+      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
+      layout:decorate="~{layout/default}">
+<head>
+  <title>일정 관리</title>
+</head>
+<body>
+
+<h1 layout:fragment="pageTitle">일정 관리</h1>
+
+<th:block layout:fragment="content">
+  <div class="banner ok" th:if="${done != null}" th:text="${done}" style="margin-bottom:12px">처리했습니다.</div>
+  <div class="banner err" th:if="${error != null}" th:text="${error}" style="margin-bottom:12px">오류 안내</div>
+
+  <div class="faint" style="margin-bottom:12px">
+    <span th:text="${view.scopeText}">개발1팀 일정</span> · 공고의 제출 마감·발표일·서류 마감은 담당 팀 일정에 자동으로 들어옵니다.
+  </div>
+
+  <!-- 월 이동 + 팀 탭(영업부·경영지원실만) -->
+  <div class="row" style="justify-content:space-between;margin-bottom:12px">
+    <div class="row">
+      <a class="btn sm" th:href="${view.selectedTeamSn != null} ? @{/schedule(ym=${view.prevYm}, team=${view.selectedTeamSn})} : @{/schedule(ym=${view.prevYm})}">‹</a>
+      <b style="font-size:16px" th:text="${view.label}">2026년 10월</b>
+      <a class="btn sm" th:href="${view.selectedTeamSn != null} ? @{/schedule(ym=${view.nextYm}, team=${view.selectedTeamSn})} : @{/schedule(ym=${view.nextYm})}">›</a>
+    </div>
+    <div class="tabs" th:if="${!#lists.isEmpty(view.teams)}">
+      <a class="tab" th:classappend="${view.selectedTeamSn == null} ? 'on'" th:href="@{/schedule(ym=${view.ym})}">전체</a>
+      <a class="tab" th:each="t : ${view.teams}"
+         th:classappend="${view.selectedTeamSn != null and view.selectedTeamSn.toString() == t.code} ? 'on'"
+         th:href="@{/schedule(ym=${view.ym}, team=${t.code})}" th:text="${t.name}">개발1팀</a>
+    </div>
+  </div>
+
+  <!-- 범례 (FR-094) -->
+  <div class="row" style="margin-bottom:12px">
+    <span style="font-size:12px" th:each="k, st : ${view.kinds}">
+      <span class="dot" th:style="|background:var(--${st.index == 0 ? 'danger' : st.index == 1 ? 'warning' : st.index == 2 ? 'accent' : st.index == 3 ? 'info' : 'success'})|"></span><span th:text="${k.name}">제출 마감</span>
+    </span>
+  </div>
+
+  <!-- 월 캘린더 (FR-091) -->
+  <div class="cal">
+    <div class="dow">일</div><div class="dow">월</div><div class="dow">화</div><div class="dow">수</div><div class="dow">목</div><div class="dow">금</div><div class="dow">토</div>
+    <div class="cell" th:each="c : ${view.cells}" th:classappend="${c.blank} ? 'dim' : (${c.today} ? 'today' : '')">
+      <div class="d" th:if="${!c.blank}" th:text="${c.day}">1</div>
+      <th:block th:each="e : ${c.events}">
+        <!-- 내부 일정은 팀장이 누르면 수정 화면으로 -->
+        <a th:if="${view.canEdit and !e.auto}" class="ev" th:classappend="|k${e.kindNo}|"
+           th:href="@{/schedule(ym=${view.ym}, edit=${e.id})}"
+           th:title="|${e.title}${e.timeText != null ? ' · ' + e.timeText : ''}|" th:text="${e.title}">내부 일정</a>
+        <div th:unless="${view.canEdit and !e.auto}" class="ev" th:classappend="|k${e.kindNo}|"
+             th:title="|${e.title}${e.timeText != null ? ' · ' + e.timeText : ''}${view.teams.isEmpty() ? '' : ' · ' + e.teamNm}|"
+             th:text="${e.title}">제출 마감</div>
+      </th:block>
+    </div>
+  </div>
+
+  <!-- 내부 일정 추가·수정 (팀장, FR-093) -->
+  <div class="card" th:if="${view.canEdit}" style="margin-top:16px">
+    <div class="card-head"><h3 th:text="${view.editing != null} ? '내부 일정 수정' : '내부 일정 추가'">내부 일정 추가</h3></div>
+    <div class="pad">
+      <form class="row" method="post"
+            th:action="${view.editing != null} ? @{/schedule/edit} : @{/schedule/add}">
+        <input type="hidden" name="ym" th:value="${view.ym}">
+        <input type="hidden" name="id" th:if="${view.editing != null}" th:value="${view.editing.id}">
+        <input type="text" name="title" maxlength="256" placeholder="일정 이름" style="width:240px" required
+               th:value="${view.editing != null} ? ${view.editing.title} : ''">
+        <input type="date" name="date" required
+               th:value="${view.editing != null} ? ${view.editing.eventDate} : ''">
+        <select name="kindCd">
+          <option th:each="k : ${view.editableKinds}" th:value="${k.code}" th:text="${k.name}"
+                  th:selected="${view.editing != null and view.editing.kindCd == k.code}">내부 1차 마감</option>
+        </select>
+        <button class="btn primary sm" type="submit" th:text="${view.editing != null} ? '수정 저장' : '추가'">추가</button>
+        <a class="btn sm" th:if="${view.editing != null}" th:href="@{/schedule(ym=${view.ym})}">취소</a>
+      </form>
+      <form method="post" th:action="@{/schedule/delete}" th:if="${view.editing != null}" style="margin-top:10px">
+        <input type="hidden" name="ym" th:value="${view.ym}">
+        <input type="hidden" name="id" th:value="${view.editing.id}">
+        <button class="btn sm danger" type="submit">이 일정 삭제</button>
+      </form>
+    </div>
+  </div>
+</th:block>
+
+</body>
+</html>
diff --git a/src/test/java/com/ojj/sujuro/schedule/ScheduleServiceTest.java b/src/test/java/com/ojj/sujuro/schedule/ScheduleServiceTest.java
new file mode 100644
index 0000000..f20e8d2
--- /dev/null
+++ b/src/test/java/com/ojj/sujuro/schedule/ScheduleServiceTest.java
@@ -0,0 +1,203 @@
+package com.ojj.sujuro.schedule;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.security.access.AccessDeniedException;
+
+import com.ojj.sujuro.auth.LoginUser;
+import com.ojj.sujuro.auth.Role;
+import com.ojj.sujuro.common.exception.BusinessException;
+import com.ojj.sujuro.user.CodeOption;
+
+/** 일정 (FR-091~094): 보는 범위, 내부 일정 권한, 입력 검사 */
+class ScheduleServiceTest {
+
+    private ScheduleMapper mapper;
+    private ScheduleService service;
+
+    @BeforeEach
+    void setUp() {
+        mapper = mock(ScheduleMapper.class);
+        service = new ScheduleService(mapper);
+    }
+
+    private LoginUser user(String empNo, Role role) {
+        return new LoginUser(empNo, empNo, "사원", "개발1팀", role, LoginUser.STATUS_ACTIVE, "x");
+    }
+
+    private CodeOption team(String sn, String nm) {
+        CodeOption c = new CodeOption();
+        c.setCode(sn);
+        c.setName(nm);
+        return c;
+    }
+
+    private ScheduleEvent event(String date, String title, String kind, Long id) {
+        ScheduleEvent e = new ScheduleEvent();
+        e.setEventDate(date);
+        e.setTitle(title);
+        e.setKindCd(kind);
+        e.setId(id);
+        return e;
+    }
+
+    @Test
+    void 영업부는_고른_팀의_일정을_본다() {
+        when(mapper.findDevTeams()).thenReturn(Arrays.asList(team("1", "개발1팀"), team("2", "개발2팀")));
+        when(mapper.findAutoEvents(eq(2L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+        when(mapper.findInternalEvents(eq(2L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+
+        ScheduleView v = service.month(user("S1", Role.SALES), "2026-10", 2L, null);
+
+        assertEquals(Long.valueOf(2L), v.getSelectedTeamSn());
+        assertFalse(v.isCanEdit());
+        verify(mapper).findAutoEvents(eq(2L), anyString(), anyString());
+    }
+
+    @Test
+    void 없는_팀을_고르면_전체로_본다() {
+        when(mapper.findDevTeams()).thenReturn(Arrays.asList(team("1", "개발1팀")));
+        when(mapper.findAutoEvents(eq((Long) null), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+        when(mapper.findInternalEvents(eq((Long) null), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+
+        ScheduleView v = service.month(user("G1", Role.MGMT), "2026-10", 999L, null);
+
+        assertNull(v.getSelectedTeamSn());
+    }
+
+    @Test
+    void 팀원은_요청한_팀과_상관없이_자기_팀만_본다() {
+        when(mapper.findMyTeamSn("M1")).thenReturn(1L);
+        when(mapper.findAutoEvents(eq(1L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+        when(mapper.findInternalEvents(eq(1L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+
+        ScheduleView v = service.month(user("M1", Role.MEMBER), "2026-10", 2L, null);
+
+        assertEquals(Long.valueOf(1L), v.getSelectedTeamSn());
+        assertFalse(v.isCanEdit());
+        verify(mapper, never()).findDevTeams();
+    }
+
+    @Test
+    void 소속_팀이_없는_팀원에게는_일정을_보여_주지_않는다() {
+        when(mapper.findMyTeamSn("M1")).thenReturn(null);
+
+        ScheduleView v = service.month(user("M1", Role.MEMBER), "2026-10", null, null);
+
+        verify(mapper, never()).findAutoEvents(any(), anyString(), anyString());
+        verify(mapper, never()).findInternalEvents(any(), anyString(), anyString());
+        assertTrue(v.getCells().stream().allMatch(c -> c.getEvents().isEmpty()));
+    }
+
+    @Test
+    void 팀장만_내부_일정을_관리할_수_있다() {
+        when(mapper.findMyTeamSn("L1")).thenReturn(1L);
+        when(mapper.findKinds()).thenReturn(Arrays.asList(team("SC010", "제출 마감"), team("SC020", "내부 1차 마감"),
+                team("SC030", "내부 2차 마감"), team("SC040", "발표"), team("SC050", "서류 마감")));
+        when(mapper.findAutoEvents(eq(1L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+        when(mapper.findInternalEvents(eq(1L), anyString(), anyString())).thenReturn(new ArrayList<ScheduleEvent>());
+
+        ScheduleView v = service.month(user("L1", Role.LEADER), "2026-10", null, null);
+
+        assertTrue(v.isCanEdit());
+        assertEquals(3, v.getEditableKinds().size()); // 내부 1차·2차 마감, 서류 마감
+    }
+
+    @Test
+    void 팀원은_내부_일정을_추가할_수_없다() {
+        assertThrows(AccessDeniedException.class,
+                () -> service.add(user("M1", Role.MEMBER), "SC020", "중간 점검", "2026-10-28"));
+        verify(mapper, never()).insert(any(), anyString(), anyString(), anyString(), anyString());
+    }
+
+    @Test
+    void 팀장은_자기_팀에_내부_일정을_추가한다() {
+        when(mapper.findMyTeamSn("L1")).thenReturn(1L);
+
+        service.add(user("L1", Role.LEADER), "SC020", "  중간 점검  ", "2026-10-28");
+
+        verify(mapper).insert(1L, "SC020", "중간 점검", "2026-10-28", "L1");
+    }
+
+    @Test
+    void 제출_마감과_발표는_직접_만들_수_없다() {
+        when(mapper.findMyTeamSn("L1")).thenReturn(1L);
+        assertThrows(BusinessException.class, () -> service.add(user("L1", Role.LEADER), "SC010", "제출", "2026-10-28"));
+        assertThrows(BusinessException.class, () -> service.add(user("L1", Role.LEADER), "SC040", "발표", "2026-10-28"));
+    }
+
+    @Test
+    void 이름과_날짜를_검사한다() {
+        when(mapper.findMyTeamSn("L1")).thenReturn(1L);
+        LoginUser l = user("L1", Role.LEADER);
+        assertThrows(BusinessException.class, () -> service.add(l, "SC020", "   ", "2026-10-28"));
+        assertThrows(BusinessException.class, () -> service.add(l, "SC020", "점검", "2026-13-40"));
+        assertThrows(BusinessException.class, () -> service.add(l, "SC020", "점검", ""));
+    }
+
+    @Test
+    void 남의_팀_일정은_수정할_수_없다() {
+        when(mapper.findMyTeamSn("L1")).thenReturn(1L);
+        when(mapper.update(9L, 1L, "SC020", "점검", "2026-10-28")).thenReturn(0);
+
+        assertThrows(BusinessException.class, () -> service.edit(user("L1", Role.LEADER), 9L, "SC020", "점검", "2026-10-28"));
+    }
+
+    @Test
