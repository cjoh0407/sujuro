# 개인 설정 예시 파일 (Git에 올림)
# 이 파일을 복사해서 application-local.properties 이름으로 만들고 값을 채우세요.
# application-local.properties는 Git에 올라가지 않습니다.

spring.datasource.url=jdbc:oracle:thin:@//DB_IP:1521/XEPDB1
spring.datasource.username=bid_app
spring.datasource.password=
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# 맥 예시: /Users/사용자/dev/upload
# 윈도우 예시: C:/dev/upload
app.upload-dir=
